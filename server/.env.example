PORT=3000
# 실제 배포(HTTPS) 시 production으로 설정하면 세션 쿠키에 secure 플래그가 강제 적용됩니다.
NODE_ENV=development

# express-session 쿠키 서명에 쓰는 임의의 긴 문자열로 교체하세요.
SESSION_SECRET=change-this-to-a-random-string

# 로그인에 사용할 단일 관리자 계정
ADMIN_USERNAME=admin
# npm run hash-password -- <비밀번호> 로 생성한 bcrypt 해시를 넣으세요.
ADMIN_PASSWORD_HASH=
